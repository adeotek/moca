// moca user config — every option, with its default or an example.
//
// Location: ~/.config/moca/config.jsonc (%APPDATA%\moca\config.jsonc on Windows).
// Format: JSONC (comments and trailing commas are fine). Keys are camelCase and
// decoding is STRICT: an unknown key is an error, not ignored. `moca config check`
// validates this file and the project one; `moca config sample` prints this text.
//
// Copying this file as-is changes nothing: every active value is the built-in
// default. Options that would REPLACE a default list or are environment-specific
// are commented out — absent means "use the built-in".
{
  // The model everyday turns use, as <provider>/<model>. There is no default:
  // a config without a model opens the TUI in setup mode (and `-p` exits 2).
  "model": "opencode-go/glm-5.3-flash",
  // `/hard` (and plan execution) escalate to this one.
  "modelHard": "opencode-go/glm-5.3",

  // Providers. The three built-ins below are already known: an entry is only
  // needed to change a URL, add a model, or point the key at another variable.
  // `apiKey` MUST be "env:VAR" — a literal secret in this file is a config error.
  "providers": {
    "anthropic": { "auth": "api_key", "apiKey": "env:ANTHROPIC_API_KEY" }, // API key only — subscription OAuth is not permitted
    "opencode-go": { "auth": "api_key", "apiKey": "env:OPENCODE_API_KEY" }, // OpenCode Zen / Go key
    "openai": { "auth": "api_key", "apiKey": "env:OPENAI_API_KEY" } // or "oauth" + `moca login openai` (ChatGPT subscription)
    // A custom or local provider (vLLM, LM Studio, Ollama, a gateway):
    // "vllm": {
    //   "baseUrl": "http://localhost:8000/v1",
    //   "baseUrls": { "openai-completions": "http://localhost:8000/v1" },  // per-protocol override
    //   "protocol": "openai-completions",            // required for a custom provider
    //   "auth": "api_key", "apiKey": "env:VLLM_API_KEY",
    //   "models": { "qwen3-coder": { "contextWindow": 131072, "maxOutputTokens": 32768,
    //                                "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 } } }
    // },
    // "ollama": { "baseUrl": "http://localhost:11434" }   // local provider; models are discovered
  },

  // ---------------------------------------------------------------------------
  // Permissions (SPECS §4, §11). `--mode` overrides the mode for one run.
  // ---------------------------------------------------------------------------
  "permissions": {
    // ask    = every non-allowlisted command asks
    // auto   = safe actions run, risky ones ask (the default)
    // yolo   = no permission checks at all
    // plan   = the plan scope: write an implementation plan, nothing else
    "defaultMode": "auto"
    // Rule lists, in precedence order (deny > ask > allow). A rule is a command
    // with optional * wildcards, e.g. "git push", "rm build/*", "docker run *".
    // Absent = none. An allow entry only ever ADDS to the built-in allowlist.
    // "allow": ["git push origin *"],
    // "ask":   ["terraform apply *"],
    // "deny":  ["curl * | sh"],
    // Auto mode's one-shot classifier for commands the risk tables cannot judge.
    // "auto": { "classifier": true, "model": "opencode-go/glm-5.3-flash" }
  },

  // Legacy spelling of `"defaultMode": "yolo"`; kept so old configs load.
  "yolo": false,

  // ---------------------------------------------------------------------------
  // Shell (SPECS §10). `allow` is the first-word allowlist for the `shell` tool.
  // ---------------------------------------------------------------------------
  // Absent = the built-in list (go, git, make, npm, docker, …). Setting it
  // REPLACES that list, so copy the default first if you extend it.
  // "shell": { "allow": ["go", "git", "make", "npm", "docker"] },

  // ---------------------------------------------------------------------------
  // MCP servers (SPECS §10.5). Lazy: nothing starts until a tool call needs it.
  // ---------------------------------------------------------------------------
  "mcp": {
    // Seconds of inactivity before a server is stopped again.
    "idleTimeout": 600
    // "servers": {
    //   "context7": { "url": "https://mcp.context7.com/mcp", "description": "library docs" },
    //   "local":    { "command": "my-mcp-server", "args": ["--stdio"],
    //                 "env": { "TOKEN": "env:MCP_TOKEN" },              // values may be "env:VAR"
    //                 "headers": { "Authorization": "env:MCP_TOKEN" },  // HTTP transport only
    //                 "approve": ["read_file"] }                        // tools approved up front
    // }
  },

  // ---------------------------------------------------------------------------
  // Web tool (SPECS §10): `fetch` needs no configuration.
  // ---------------------------------------------------------------------------
  "web": {
    "search": {
      "provider": "tavily" // "tavily" (keyless, rate-limited) | "exa" (needs a key)
      // "apiKey": "env:TAVILY_API_KEY"
    }
  },

  // ---------------------------------------------------------------------------
  // Context and compaction (SPECS §14).
  // ---------------------------------------------------------------------------
  "context": {
    "reserveTokens": 16384, // headroom kept for the reply
    "keepRecentTokens": 20000, // recent turns a compaction never rewrites
    "maxSteps": 40, // tool-call steps before the run is wrapped up
    "progressNudgeAt": 12 // tool batches with no file change before one "start acting" nudge; 0 disables
  },

  // Pre-edit snapshots under the data dir; how long they are kept.
  "snapshot": { "retentionDays": 30 }, // 0 = keep forever

  // ---------------------------------------------------------------------------
  // TUI (SPECS §3.5).
  // ---------------------------------------------------------------------------
  "tui": {
    // How a finished long run or a waiting approval signals an unfocused terminal.
    "notify": "osc9" // "osc9" (desktop notification) | "bell" | "off"
    // Colors: each role takes a #rrggbb hex or an ANSI color number (0-255).
    // Every role has a built-in default in internal/tui/theme.go, and the
    // interactive builder (docs/tui-theme-builder.html) emits a ready block.
    // "theme": {
    //   "both": { "accent": "#d97706" },
    //   "dark": { "userBg": "#141618", "respBg": "#0a1619" },
    //   "light": { "userBg": "#f6f8fa" }
    // }
  },

  // ---------------------------------------------------------------------------
  // Self-managed project skills (SPECS §12). OFF unless this is true — the only
  // opt-in; a trusted project file can opt a repository out with false.
  // ---------------------------------------------------------------------------
  "skills": {
    "selfManaged": false
    // The end-of-run recording nudge is on by default; false turns it off.
    // "recordNudge": true
  },

  // Diagnostic log: ~/.local/state/moca/logs (MOCA_LOG overrides for one run).
  "log": { "level": "info" } // "info" | "debug" | "off"
}
