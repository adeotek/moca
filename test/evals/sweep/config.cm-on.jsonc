{
  // codemode pilot arm: the treatment. `codemode` is ON (workspace only — v1 has
  // no network key), so the model gets the ninth tool. The control
  // (config.cm-off.jsonc) carries no codemode block at all, which is the whole
  // arm difference; `pilot_preflight` refuses a pilot run without -c.
  "model": "opencode-go/deepseek-v4.1-flash",
  "providers": { "opencode-go": { "apiKey": "env:OPENCODE_API_KEY" } },
  "codemode": { "enabled": true }
}
