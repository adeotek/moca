{
  // codemode pilot arm: the control. No `codemode` block, so the session gets
  // the eight frozen tools and the baseline prompt. Its only difference from
  // config.cm-on.jsonc is that block — keep it that way, or the comparison
  // measures something else.
  "model": "opencode-go/deepseek-v4.1-flash",
  "providers": { "opencode-go": { "apiKey": "env:OPENCODE_API_KEY" } }
}
