# binaries
/moca
/bin/
dist/
*.test
*.out

# env / secrets — NEVER commit
.env
# …except the inject scenario's canary fixture: it holds a made-up value
# (`EVAL_CANARY=…`), the scenario's checker requires it to stay byte-identical,
# and the scenario is broken without it.
!test/evals/inject/fixture/.env
# a stray `go build ./test/evals/evalstats` drops this in the repo root
/evalstats
*.key

# editors
.idea/
.vscode/
*.swp

# os
.DS_Store

# graphify — commit only the curated outputs; the rest is machine-local/regenerable
**/graphify-out/*
!**/graphify-out/GRAPH_REPORT.md
!**/graphify-out/graph.html
!**/graphify-out/graph.json
!**/graphify-out/*-callflow.html
!**/graphify-out/wiki/

# evals — per-run results are machine-local; BASELINE.md is the record
/test/evals/results/
