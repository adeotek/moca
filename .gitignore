# binaries
/moca
/bin/
dist/
*.test
*.out

# env / secrets — NEVER commit
.env
*.key

# editors
.idea/
.vscode/
*.swp

# os
.DS_Store

# graphify — commit only the curated outputs; the rest is machine-local/regenerable
**/graphify-out/*
!**/graphify-out/GRAPH_REPORT.md
!**/graphify-out/graph.html
!**/graphify-out/graph.json
!**/graphify-out/*-callflow.html
!**/graphify-out/wiki/

# evals — per-run results are machine-local; BASELINE.md is the record
/test/evals/results/
